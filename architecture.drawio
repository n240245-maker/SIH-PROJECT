  <diagram id="DATA" name="Data Sources &amp; Prototype Schema">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1080" math="0" shadow="0">
