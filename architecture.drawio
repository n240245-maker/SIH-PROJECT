        <mxCell id="TRAINING_proc" value="• Time-aware train/validation/test split&lt;br&gt;&lt;br&gt;• Fit Isolation Forest / robust peer baselines&lt;br&gt;&lt;br&gt;• Train delay and overrun predictor&lt;br&gt;&lt;br&gt;• Calibrate duplicate thresholds&lt;br&gt;&lt;br&gt;• Version compliance rule pack&lt;br&gt;&lt;br&gt;• Tune thresholds against review-queue quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF8;strokeColor=#1D8F84;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=8;shadow=1;fontColor=#17212B;" vertex="1" parent="1">
