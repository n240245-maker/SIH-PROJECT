        <mxCell id="GROK_proc" value="• Retrieve relevant guideline text&lt;br&gt;&lt;br&gt;• Construct grounded prompt&lt;br&gt;&lt;br&gt;• Call Grok API&lt;br&gt;&lt;br&gt;• Require structured JSON response&lt;br&gt;&lt;br&gt;• Return why flagged + evidence + guideline context + next checks&lt;br&gt;&lt;br&gt;• Reject unsupported statements and preserve source references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF8;strokeColor=#1D8F84;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=8;shadow=1;fontColor=#17212B;" vertex="1" parent="1">
