        <mxCell id="DATA_why" value="&lt;b&gt;WHY THIS EXISTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use the data the problem actually requires and preserve enough provenance to replace demo rows with official eSAKSHI/MoSPI records later." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8DEE8;strokeWidth=2;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#17212B;" vertex="1" parent="1">
          <mxGeometry x="50" y="105" width="1740" height="110" as="geometry"/>
        </mxCell>
