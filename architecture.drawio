        <mxCell id="DATA_h2" value="OUTPUTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FA;strokeColor=#D9682C;strokeWidth=2;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="1310" y="255" width="480" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="DATA_in" value="• 01_mp_master.csv + official allocation/calamity files&lt;br&gt;&lt;br&gt;• 02_agencies_vendors.csv&lt;br&gt;&lt;br&gt;• 03_works.csv&lt;br&gt;&lt;br&gt;• 04_payments.csv&lt;br&gt;&lt;br&gt;• 05_progress.csv&lt;br&gt;&lt;br&gt;• 06_assets_compliance.csv&lt;br&gt;&lt;br&gt;• Official MPLADS guidelines / norms&lt;br&gt;&lt;br&gt;• Future authorized eSAKSHI exports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6FAFF;strokeColor=#2E6BFF;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=10;fontColor=#17212B;" vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="480" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="DATA_proc" value="• Keep raw source files immutable&lt;br&gt;&lt;br&gt;• Mark source_type and synthetic/real/public/derived provenance&lt;br&gt;&lt;br&gt;• Map into canonical MP, Work, Payment, Progress, Entity and Asset tables&lt;br&gt;&lt;br&gt;• Exclude evaluation-only ground-truth labels from model features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF8;strokeColor=#1D8F84;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacing=8;shadow=1;fontColor=#17212B;" vertex="1" parent="1">
          <mxGeometry x="680" y="330" width="480" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="DATA_out" value="• Auditable source inventory&lt;br&gt;&lt;br&gt;• Canonical database schema&lt;br&gt;&lt;br&gt;• Real-vs-synthetic lineage&lt;br&gt;&lt;br&gt;• Replaceable source adapters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F2;strokeColor=#D9682C;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=9;fontColor=#17212B;" vertex="1" parent="1">
          <mxGeometry x="1310" y="330" width="480" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="DATA_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;flowAnimation=1;strokeColor=#1D8F84;" edge="1" parent="1" source="DATA_in" target="DATA_proc">
