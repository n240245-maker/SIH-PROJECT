        <mxCell id="TRAINING_in" value="• Feature store&lt;br&gt;&lt;br&gt;• Historical completed works&lt;br&gt;&lt;br&gt;• Synthetic anomaly labels for benchmarking only&lt;br&gt;&lt;br&gt;• Known synthetic duplicate pairs&lt;br&gt;&lt;br&gt;• Versioned MPLADS rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6FAFF;strokeColor=#2E6BFF;strokeWidth=2;fontSize=14;align=left;verticalAlign=middle;spacing=10;fontColor=#17212B;" vertex="1" parent="1">
